PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Client-IP resolution (per-IP rate limiting) ──────────────────────────
# Forwarding headers are believed ONLY when the socket peer is listed below.
# Anything connecting from elsewhere is treated as the client itself, so a
# forged CF-Connecting-IP / X-Forwarded-For cannot widen a caller's quota.
#
# TRUSTED_PROXIES: 'loopback' (default), 'private', bare IPs, or CIDR blocks.
#   Cloudflare Tunnel -> loopback (cloudflared connects over localhost)
#   Reverse proxy on the same host -> loopback
#   Proxy on another host -> that host's IP or CIDR
#   Exposed directly with no proxy -> leave as loopback; headers are ignored
TRUSTED_PROXIES=loopback

# CLIENT_IP_SOURCE: auto (default) | cloudflare | xff | socket
#   auto       prefers CF-Connecting-IP, falls back to X-Forwarded-For
#   cloudflare CF-Connecting-IP only
#   xff        X-Forwarded-For only (uses TRUST_PROXY below)
#   socket     ignore all headers; use the direct peer address
CLIENT_IP_SOURCE=auto

# Proxy hops for the X-Forwarded-For path only. Use 1 behind a single proxy.
TRUST_PROXY=1

DISCORD_BOT_TOKEN=your_discord_bot_token_here

DISCORD_NOTIFICATION_CHANNEL_ID=your_discord_channel_id_here

DISCORD_ARTIST_USER_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_SECURE=false
SMTP_USER=your_smtp_username_here@gmail.com

SMTP_PASS=your_smtp_app_password_here
SMTP_FROM='"Cloudy Portfolio Relayer" <your_smtp_username_here@gmail.com>'

ARTIST_EMAIL=artist_personal_email@example.com
